{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baselines.cirsec.org/schema/control.schema.json",
  "title": "CIRSEC Baselines - control (controls/<ID>.yml)",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": { "^x-": {} },
  "required": [
    "id", "title", "finding", "status", "profiles", "risk", "assessment",
    "description", "rationale", "impact", "audit", "remediation",
    "references", "authors", "introduced_in", "created", "updated"
  ],
  "properties": {

    "id": {
      "$ref": "#/$defs/control_id",
      "description": "CB-<STANDARD>-<DOMAIN>-<NNN>. Must match the file name. Never reused, never renumbered."
    },
    "title": {
      "type": "string", "minLength": 1, "maxLength": 140,
      "description": "The recommendation, in our own words, phrased as the desired state."
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "description": "How a failed check is presented in a report: describes the problem, not the rule.",
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 140 },
        "description": { "type": "string", "description": "Markdown. Short explanation of the exposure." }
      }
    },
    "status": { "enum": ["draft", "review", "active", "deprecated"] },
    "profiles": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/slug" },
      "description": "Profile keys declared in _standard.yml."
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity"],
      "properties": {
        "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
        "score": { "type": "number", "minimum": 0, "maximum": 10, "description": "Optional 0-10 score refining severity." }
      }
    },
    "assessment": {
      "enum": ["automated", "partial", "manual"],
      "description": "automated: fully checkable by audit.checks. partial: some aspects need a human. manual: human review only."
    },
    "tags": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/slug" } },

    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "description": "When the control applies. Omitted means: all versions of the standard, no prerequisite.",
      "properties": {
        "versions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" }, "description": "Subset of the standard's applies_to versions." },
        "requires": { "type": "array", "uniqueItems": true, "items": { "type": "string" }, "description": "Licenses, editions or features required (e.g. 'Microsoft Entra ID P1')." },
        "conditions": { "type": "string", "description": "Markdown. Other conditions (e.g. 'only if hybrid Exchange is deployed')." }
      }
    },

    "description": { "type": "string", "minLength": 1, "description": "Markdown. What the setting or practice is." },
    "rationale": { "type": "string", "minLength": 1, "description": "Markdown. Why it matters, which attacks or mistakes it prevents." },
    "impact": { "type": "string", "minLength": 1, "description": "Markdown. Operational side effects of applying it. Write 'None known.' if none." },
    "notes": { "type": "string", "description": "Markdown. Anything else: edge cases, exceptions, known vendor quirks." },

    "setting": {
      "type": "object",
      "additionalProperties": false,
      "description": "Where the setting lives, when the control is about one setting.",
      "properties": {
        "location": { "type": "string", "description": "UI path, config file, registry key, API resource..." },
        "default_value": { "type": "string", "description": "Vendor default." },
        "recommended_value": { "type": "string", "description": "Human-readable target. May reference parameters as {{ name }}." }
      }
    },

    "parameters": {
      "type": "array",
      "description": "Tunable values. Checks and scripts reference them as {{ name }}. Users override them to customize the baseline.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "description", "default"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "type": { "enum": ["string", "integer", "number", "boolean", "enum", "list"] },
          "description": { "type": "string" },
          "unit": { "type": "string", "description": "e.g. days, minutes, characters." },
          "default": { "description": "Default value, used by every profile without its own value." },
          "profile_defaults": { "type": "object", "propertyNames": { "$ref": "#/$defs/slug" }, "description": "Per-profile default values." },
          "minimum": { "type": "number" },
          "maximum": { "type": "number" },
          "allowed": { "type": "array", "minItems": 1, "description": "Allowed values (required for type enum)." }
        },
        "allOf": [
          { "if": { "properties": { "type": { "const": "enum" } } }, "then": { "required": ["allowed"] } }
        ]
      }
    },

    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manual"],
      "properties": {
        "manual": { "type": "string", "minLength": 1, "description": "Markdown. How a human checks it." },
        "logic": { "enum": ["all", "any"], "default": "all", "description": "Whether all checks or any check must pass." },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "patternProperties": { "^x-": {} },
            "required": ["id", "engine", "spec"],
            "properties": {
              "id": { "$ref": "#/$defs/slug", "description": "Stable within the control, used to report per-check results." },
              "engine": { "$ref": "#/$defs/slug", "description": "Engine key declared in baselines.yml." },
              "description": { "type": "string" },
              "versions": { "type": "array", "uniqueItems": true, "items": { "type": "string" }, "description": "Restrict this check to some versions." },
              "spec": { "type": "object", "description": "Engine-specific payload." }
            }
          }
        }
      }
    },

    "remediation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manual"],
      "properties": {
        "manual": { "type": "string", "minLength": 1, "description": "Markdown. How to fix it." },
        "requires_restart": { "type": "boolean", "description": "Service or system restart needed." },
        "rollback": { "type": "string", "description": "Markdown. How to revert." },
        "scripts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "patternProperties": { "^x-": {} },
            "required": ["id", "engine", "content"],
            "properties": {
              "id": { "$ref": "#/$defs/slug" },
              "engine": { "$ref": "#/$defs/slug", "description": "Engine key declared in baselines.yml." },
              "description": { "type": "string" },
              "versions": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
              "content": { "type": "string" }
            }
          }
        }
      }
    },

    "references": {
      "type": "array", "minItems": 1,
      "description": "Primary sources used to write this control (clean-room provenance). Never a proprietary benchmark.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url"],
        "properties": {
          "title": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "publisher": { "type": "string" },
          "kind": { "enum": ["vendor-doc", "standard", "rfc", "guide", "paper", "tool", "other"] },
          "accessed": { "type": "string", "format": "date", "description": "When the source was last read. SaaS docs change." }
        }
      }
    },
    "mappings": {
      "type": "array",
      "description": "Links to control frameworks (kind control-framework in baselines.yml). Identifiers only, see reference_policy.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["framework", "id", "relation"],
        "properties": {
          "framework": { "$ref": "#/$defs/slug" },
          "framework_version": { "type": "string" },
          "id": { "type": "string", "minLength": 1 },
          "relation": { "enum": ["equivalent", "stricter", "looser", "partial", "related"], "description": "How OUR control relates to theirs." },
          "note": { "type": "string", "description": "Our own words explaining the difference." }
        }
      }
    },
    "threats": {
      "type": "array",
      "description": "Threats mitigated: ATT&CK techniques, CWE, CVE... (frameworks of the other kinds in baselines.yml).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["framework", "id"],
        "properties": {
          "framework": { "$ref": "#/$defs/slug" },
          "id": { "type": "string", "minLength": 1 },
          "note": { "type": "string" }
        }
      }
    },
    "related_controls": {
      "type": "array",
      "description": "Links to other CIRSEC controls, any standard.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type"],
        "properties": {
          "id": { "$ref": "#/$defs/control_id" },
          "type": { "enum": ["requires", "related", "conflicts"] },
          "note": { "type": "string" }
        }
      }
    },

    "authors": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/person" } },
    "reviewers": { "type": "array", "items": { "$ref": "#/$defs/person" } },
    "verified": {
      "type": "array",
      "description": "Times the control was tested against a real environment.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "by"],
        "properties": {
          "date": { "type": "string", "format": "date" },
          "by": { "type": "string" },
          "environment": { "type": "string", "description": "e.g. 'M365 E3 tenant', 'Debian 12.7 VM'." },
          "notes": { "type": "string" }
        }
      }
    },
    "introduced_in": { "$ref": "#/$defs/semver", "description": "Standard version where the control first appeared." },
    "deprecated_in": { "$ref": "#/$defs/semver" },
    "deprecation_reason": { "type": "string" },
    "supersedes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/control_id" } },
    "superseded_by": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/control_id" }, "description": "Empty list if the control is retired without replacement." },
    "created": { "type": "string", "format": "date" },
    "updated": { "type": "string", "format": "date" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "deprecated" } } },
      "then": { "required": ["deprecated_in", "deprecation_reason", "superseded_by"] }
    },
    {
      "if": { "properties": { "assessment": { "const": "automated" } } },
      "then": { "properties": { "audit": { "required": ["checks"], "properties": { "checks": { "minItems": 1 } } } } }
    }
  ],
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "control_id": { "type": "string", "pattern": "^CB-[A-Z0-9]+-[A-Z0-9]+-[0-9]{3}$" },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$" },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "github": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "affiliation": { "type": "string" }
      }
    }
  }
}

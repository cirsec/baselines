{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baselines.cirsec.org/schema/control-i18n.schema.json",
  "title": "CIRSEC Baselines - control translation (i18n/<locale>/<ID>.yml)",
  "description": "Only translatable text. Everything structural (IDs, checks, parameters values, mappings) stays in the source control.",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": { "^x-": {} },
  "required": ["id", "locale", "source_updated", "translators", "title"],
  "properties": {
    "id": { "type": "string", "pattern": "^CB-[A-Z0-9]+-[A-Z0-9]+-[0-9]{3}$", "description": "Must match the file name and an existing control." },
    "locale": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$", "description": "Must match the i18n/<locale>/ folder." },
    "source_updated": { "type": "string", "format": "date", "description": "The 'updated' date of the source control this translation was made from. Older than the source = stale." },
    "translators": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": { "name": { "type": "string" }, "github": { "type": "string" } }
      }
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 140 },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "title": { "type": "string" }, "description": { "type": "string" } }
    },
    "description": { "type": "string" },
    "rationale": { "type": "string" },
    "impact": { "type": "string" },
    "notes": { "type": "string" },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "conditions": { "type": "string" } }
    },
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "location": { "type": "string" }, "recommended_value": { "type": "string" } }
    },
    "parameters": {
      "type": "object",
      "description": "Parameter descriptions keyed by parameter name.",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": { "type": "string" }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "manual": { "type": "string" } }
    },
    "remediation": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "manual": { "type": "string" }, "rollback": { "type": "string" } }
    }
  }
}

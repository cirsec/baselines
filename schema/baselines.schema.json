{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baselines.cirsec.org/schema/baselines.schema.json",
  "title": "CIRSEC Baselines - root metadata (baselines.yml)",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": { "^x-": {} },
  "required": ["schema_version", "project", "licenses", "locales", "id_format", "engines", "frameworks"],
  "properties": {
    "schema_version": { "const": 2 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "repository"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "repository": { "type": "string", "format": "uri" },
        "contact": { "type": "string", "format": "email" }
      }
    },
    "licenses": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content", "code", "tooling"],
      "properties": {
        "content": { "type": "string", "description": "SPDX identifier for control text." },
        "code": { "type": "string", "description": "SPDX identifier for code inside controls (scripts, script files, specs of script engines) and for artifacts generated from them." },
        "tooling": { "type": "string", "description": "SPDX identifier for schemas and tools." }
      }
    },
    "locales": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "available"],
      "properties": {
        "default": { "$ref": "#/$defs/locale", "description": "Locale of the source control files." },
        "available": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/locale" } }
      }
    },
    "id_format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern", "template"],
      "properties": {
        "pattern": { "type": "string", "format": "regex" },
        "template": { "type": "string" },
        "example": { "type": "string" }
      }
    },
    "engines": {
      "type": "array",
      "minItems": 1,
      "description": "Engines usable in audit.checks[], remediation.scripts[] and standard facts. Generators for each output format (bash, Ansible...) live in the tooling, not here.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "patternProperties": { "^x-": {} },
        "required": ["key", "title", "description", "capabilities", "spec_schema"],
        "properties": {
          "key": { "$ref": "#/$defs/slug" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "capabilities": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "enum": ["check", "fix", "script"] },
            "description": "check: evaluates a declarative spec. fix: generates the remediation from a check spec (scripts[].from_check). script: accepts handwritten code (scripts[].content or file)."
          },
          "spec_schema": {
            "type": "string", "pattern": "^schema/engines/[a-z0-9-]+\\.schema\\.json$",
            "description": "Path from the repository root of the JSON Schema that every spec of this engine must match."
          }
        }
      }
    },
    "frameworks": {
      "type": "array",
      "minItems": 1,
      "description": "External references usable in controls: mappings (kind control-framework) and threats (other kinds).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "patternProperties": { "^x-": {} },
        "required": ["key", "kind", "name", "publisher", "reference_policy"],
        "properties": {
          "key": { "$ref": "#/$defs/slug" },
          "kind": { "enum": ["control-framework", "threat-taxonomy", "weakness-taxonomy", "vulnerability-database"] },
          "name": { "type": "string" },
          "publisher": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "id_pattern": { "type": "string", "format": "regex", "description": "Regex every referenced identifier must match." },
          "display_order": { "type": "integer", "minimum": 0, "description": "Sort key when mappings are displayed, lower first. Open public frameworks come before id-only ones." },
          "reference_policy": {
            "enum": ["id-only", "id-title"],
            "description": "id-only: only identifiers may be written in this repository. id-title: identifiers and official titles are allowed."
          }
        }
      }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "locale": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" }
  }
}

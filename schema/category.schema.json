{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baselines.cirsec.org/schema/category.schema.json",
  "title": "CIRSEC Baselines - category (_category.yml)",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": { "^x-": {} },
  "required": ["id", "title", "description", "order"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "Must match the category folder name." },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "order": { "type": "integer", "minimum": 0, "description": "Display order, ascending." },
    "i18n": {
      "type": "object",
      "description": "Translations keyed by locale.",
      "propertyNames": { "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    }
  }
}

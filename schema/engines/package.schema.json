{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baselines.cirsec.org/schema/engines/package.schema.json",
  "title": "CIRSEC Baselines - Debian package check spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "state"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9+.-]+$"
    },
    "state": {
      "enum": [
        "installed",
        "absent"
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baselines.cirsec.org/schema/engines/file-content.schema.json",
  "title": "CIRSEC Baselines - File content check spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "path",
    "pattern"
  ],
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1,
      "description": "Absolute path, glob allowed."
    },
    "pattern": {
      "type": "string",
      "format": "regex",
      "description": "Regex matched line by line."
    },
    "expect": {
      "enum": [
        "match",
        "no_match"
      ],
      "default": "match"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baselines.cirsec.org/schema/engines/file-perms.schema.json",
  "title": "CIRSEC Baselines - File ownership and mode check spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "path"
  ],
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1,
      "description": "Absolute path, glob allowed."
    },
    "owner": {
      "type": "string"
    },
    "group": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "pattern": "^0?[0-7]{3,4}$",
      "description": "Maximum mode: the check fails if any bit outside it is set."
    }
  },
  "anyOf": [
    {
      "required": [
        "owner"
      ]
    },
    {
      "required": [
        "group"
      ]
    },
    {
      "required": [
        "mode"
      ]
    }
  ]
}

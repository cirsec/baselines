{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baselines.cirsec.org/schema/engines/powershell.schema.json",
  "title": "CIRSEC Baselines - PowerShell check spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "script"
  ],
  "properties": {
    "script": {
      "type": "string",
      "minLength": 1,
      "description": "PowerShell script. Same exit codes as shell. Parameters arrive as CB_<NAME> environment variables."
    }
  }
}

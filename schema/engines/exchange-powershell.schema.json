{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baselines.cirsec.org/schema/engines/exchange-powershell.schema.json",
  "title": "CIRSEC Baselines - Exchange Online PowerShell check spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cmdlet",
    "property",
    "value"
  ],
  "properties": {
    "cmdlet": {
      "type": "string",
      "pattern": "^Get-[A-Za-z]+$",
      "description": "Read-only cmdlet."
    },
    "parameters": {
      "type": "object",
      "description": "Cmdlet parameters."
    },
    "property": {
      "type": "string",
      "minLength": 1,
      "description": "Property of the returned object(s)."
    },
    "operator": {
      "enum": [
        "==",
        "!=",
        "<",
        "<=",
        ">",
        ">=",
        "in",
        "not_in",
        "match"
      ],
      "default": "==",
      "description": "How the observed value compares to value. match = regex."
    },
    "value": {
      "description": "Expected value. May be a single {{ parameter }}, resolved with its type."
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baselines.cirsec.org/schema/engines/demo-sensor.schema.json",
  "title": "CIRSEC Baselines - [DEMO] Buffet sensor check spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sensor",
    "value"
  ],
  "properties": {
    "sensor": {
      "type": "string",
      "minLength": 1,
      "description": "Sensor path, glob allowed."
    },
    "operator": {
      "enum": [
        "==",
        "!=",
        "<",
        "<=",
        ">",
        ">=",
        "in",
        "not_in",
        "match"
      ],
      "default": "==",
      "description": "How the observed value compares to value. match = regex."
    },
    "value": {
      "description": "Expected value. May be a single {{ parameter }}, resolved with its type."
    }
  }
}

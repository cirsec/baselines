{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baselines.cirsec.org/schema/engines/systemd-unit.schema.json",
  "title": "CIRSEC Baselines - systemd unit check spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "unit",
    "state"
  ],
  "properties": {
    "unit": {
      "type": "string",
      "pattern": "^[A-Za-z0-9@._-]+\\.(service|socket|timer|mount|target|path)$"
    },
    "state": {
      "enum": [
        "enabled",
        "disabled",
        "masked"
      ],
      "description": "Fix also starts (enabled) or stops (disabled, masked) the unit."
    }
  }
}

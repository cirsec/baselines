{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baselines.cirsec.org/schema/engines/osquery.schema.json",
  "title": "CIRSEC Baselines - osquery check spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "query"
  ],
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1,
      "description": "osquery SQL."
    },
    "expect": {
      "enum": [
        "rows",
        "no_rows"
      ],
      "default": "rows",
      "description": "rows: pass when the query returns at least one row."
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baselines.cirsec.org/schema/engines/windows-registry.schema.json",
  "title": "CIRSEC Baselines - Windows registry check spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hive",
    "key",
    "name",
    "type",
    "value"
  ],
  "properties": {
    "hive": {
      "enum": [
        "HKLM",
        "HKCU",
        "HKU"
      ]
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "description": "Key path under the hive, e.g. SOFTWARE\\Policies\\Microsoft\\Windows\\System."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Value name."
    },
    "type": {
      "enum": [
        "REG_DWORD",
        "REG_QWORD",
        "REG_SZ",
        "REG_EXPAND_SZ",
        "REG_MULTI_SZ"
      ]
    },
    "operator": {
      "enum": [
        "==",
        "!=",
        "<",
        "<=",
        ">",
        ">=",
        "in",
        "not_in",
        "match"
      ],
      "default": "==",
      "description": "How the observed value compares to value. match = regex."
    },
    "value": {
      "description": "Expected value. May be a single {{ parameter }}, resolved with its type."
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baselines.cirsec.org/schema/engines/dconf.schema.json",
  "title": "CIRSEC Baselines - dconf (GNOME) check spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "key",
    "value"
  ],
  "properties": {
    "key": {
      "type": "string",
      "pattern": "^/",
      "description": "e.g. /org/gnome/desktop/screensaver/lock-enabled."
    },
    "value": {
      "description": "GVariant text, e.g. true, uint32 300, 'string'. May be a {{ parameter }}."
    },
    "locked": {
      "type": "boolean",
      "default": true,
      "description": "Fix also locks the key so users cannot change it."
    }
  }
}

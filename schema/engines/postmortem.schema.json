{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baselines.cirsec.org/schema/engines/postmortem.schema.json",
  "title": "CIRSEC Baselines - postmortem check spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "command",
    "control",
    "coverage"
  ],
  "properties": {
    "command": {
      "type": "string",
      "minLength": 1,
      "description": "Command line, e.g. postmortem harden --json."
    },
    "control": {
      "type": "string",
      "pattern": "^CB-[A-Z0-9]+-[A-Z0-9]+-[0-9]{3}$"
    },
    "coverage": {
      "enum": [
        "auto",
        "online",
        "partial"
      ]
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
